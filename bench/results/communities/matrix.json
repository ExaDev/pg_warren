{
  "graphs": {
    "smoke": {"generate": ["random", "--nodes", "20000", "--edges", "0", "--seed", "1"]},
    "blocks-1m": {"generate": ["random", "--nodes", "1000000", "--edges", "0", "--seed", "1"]},
    "blocks-10m": {"generate": ["random", "--nodes", "10000000", "--edges", "0", "--seed", "1"]}
  },
  "setup": [
    "DO $$ BEGIN EXECUTE format('ALTER DATABASE %I SET warren.threads = 4', current_database()); END $$",
    "SELECT warren.create_graph('g', 'SELECT id FROM nodes', 'SELECT n.id, CASE WHEN abs(hashint8(n.id * 8 + k)) % 10 < 9 THEN (n.id - 1) / 1000 * 1000 + 1 + abs(hashint8(-(n.id * 8 + k))) % 1000 ELSE 1 + abs(hashint8(-(n.id * 8 + k))) % (SELECT max(id) FROM nodes) END, CASE WHEN abs(hashint8(n.id * 8 + k)) % 10 < 9 THEN ''in'' ELSE ''out'' END FROM nodes n, generate_series(1, 5) k', directed := false, has_relations := true, build_reverse := false, store_merged := false)"
  ],
  "params": "SELECT count(*) AS nodes FROM nodes",
  "workloads": [
    {"name": "refresh", "sql": "SELECT warren.refresh('g')", "repeat": 1},
    {"name": "prewarm", "sql": "SELECT warren.prewarm('g')"},
    {"name": "components_vector_in", "requires": ["warren.components_vector"], "sql": "SELECT warren.components_vector('g', 'cc', rels := ARRAY['in'])", "repeat": 1},
    {"name": "contract_by_components", "requires": ["warren.contract"], "sql": "SELECT warren.contract('g', 'cc', 'q')"},
    {"name": "project_count", "requires": ["warren.project"], "sql": "SELECT warren.project('g', 'cc', 'q', 'members', 'count')"},
    {"name": "project_mean", "requires": ["warren.project"], "sql": "SELECT warren.project('g', 'cc', 'q', 'mean_label', 'mean', persist := false)"},
    {"name": "lift", "requires": ["warren.lift"], "sql": "SELECT warren.lift('q', 'members', 'g', 'community_size', persist := false)"},
    {"name": "dense_ids", "requires": ["warren.vector_dense_id"], "sql": "SELECT warren.vector_dense_id('g', 'ids')", "repeat": 1},
    {"name": "contract_by_dense_ids", "requires": ["warren.contract"], "sql": "SELECT warren.contract('g', 'ids', 'identity')", "repeat": 1},
    {"name": "modularity_of_blocks", "requires": ["warren.modularity"], "sql": "SELECT warren.modularity('g', 'cc')"},
    {"name": "louvain", "requires": ["warren.louvain"], "sql": "SELECT warren.louvain('g', 'louvain', levels_prefix := 'louvain')", "repeat": 1},
    {"name": "leiden", "requires": ["warren.leiden"], "sql": "SELECT warren.leiden('g', 'leiden', levels_prefix := 'leiden')", "repeat": 1},
    {"name": "leiden_iterations_1", "requires": ["warren.leiden"], "sql": "SELECT warren.leiden('g', 'leiden_once', iterations := 1)", "repeat": 1},
    {"name": "modularity_louvain", "requires": ["warren.louvain"], "sql": "SELECT warren.modularity('g', 'louvain')", "repeat": 1},
    {"name": "modularity_leiden", "requires": ["warren.leiden"], "sql": "SELECT warren.modularity('g', 'leiden')", "repeat": 1},
    {"name": "louvain_max_levels_1", "requires": ["warren.louvain"], "sql": "SELECT warren.louvain('g', 'louvain_upto_1', max_levels := 1)", "repeat": 1},
    {"name": "louvain_max_levels_2", "requires": ["warren.louvain"], "sql": "SELECT warren.louvain('g', 'louvain_upto_2', max_levels := 2)", "repeat": 1},
    {"name": "louvain_max_levels_3", "requires": ["warren.louvain"], "sql": "SELECT warren.louvain('g', 'louvain_upto_3', max_levels := 3)", "repeat": 1},
    {"name": "leiden_max_levels_1", "requires": ["warren.leiden"], "sql": "SELECT warren.leiden('g', 'leiden_upto_1', max_levels := 1, iterations := 1)", "repeat": 1},
    {"name": "leiden_max_levels_2", "requires": ["warren.leiden"], "sql": "SELECT warren.leiden('g', 'leiden_upto_2', max_levels := 2, iterations := 1)", "repeat": 1},
    {"name": "leiden_max_levels_3", "requires": ["warren.leiden"], "sql": "SELECT warren.leiden('g', 'leiden_upto_3', max_levels := 3, iterations := 1)", "repeat": 1}
  ]
}
