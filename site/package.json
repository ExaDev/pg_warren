    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.7",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.2"
  }
}
