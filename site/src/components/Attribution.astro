---
import ExaDev from '../assets/exadev.svg';
---

<a class="attribution" href="https://exadev.io"><span>by</span><ExaDev width="18" height="18" aria-hidden="true" /><span>ExaDev</span></a>

<style>
  .attribution {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    font: 400 13px/18px 'DM Sans Variable', sans-serif;
    color: inherit;
    text-decoration: none;
    letter-spacing: 0;
  }
  .attribution:hover span { text-decoration: underline; text-underline-offset: 3px; }
  .attribution :global(svg) { display: block; width: 18px; height: 18px; flex-shrink: 0; }
  :global([data-theme='dark']) .attribution :global(path[fill='#222831']) { fill: #dce5dd; }
  :global([data-theme='dark']) .attribution :global(path[fill='#434953']) { fill: #a6b3aa; }
</style>
