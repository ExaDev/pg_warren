---
import { Code } from 'astro:components';
import mark from '../assets/mark.svg';
import Attribution from '../components/Attribution.astro';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ExaDev/pg_warren';
const query = `SELECT p.name, b.depth
FROM warren.bfs('social', ARRAY[1::bigint], 3) b
JOIN people p ON p.id = b.node_id
ORDER BY b.depth, p.name;`;
const setup = `CREATE EXTENSION pg_warren;

CREATE TABLE people (id bigint PRIMARY KEY, name text NOT NULL);
CREATE TABLE follows (src bigint NOT NULL, dst bigint NOT NULL);
INSERT INTO people VALUES
  (1, 'ada'), (2, 'bob'), (3, 'cy'), (4, 'dee'), (5, 'eve');
INSERT INTO follows VALUES (1, 2), (2, 3), (3, 1), (3, 4), (4, 5);

SELECT warren.create_graph('social',
  'SELECT id FROM people', 'SELECT src, dst FROM follows');
SELECT warren.refresh('social');`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Deep graph traversal and whole-graph computation inside PostgreSQL, over nodes and edges in ordinary tables." />
    <meta name="theme-color" content="#f7f6ef" />
    <meta property="og:title" content="pg_warren — Fast graph analytics inside PostgreSQL" />
    <meta property="og:description" content="Deep traversal and whole-graph computation, inside PostgreSQL, over your ordinary tables." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://exadev.github.io/pg_warren/" />
    <link rel="canonical" href="https://exadev.github.io/pg_warren/" />
    <link rel="icon" type="image/svg+xml" href={mark.src} />
    <title>pg_warren — Fast graph analytics inside PostgreSQL</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark'
          ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <div class="brand-stack"><a class="brand" href={`${base}/`} aria-label="pg_warren home"><img src={mark.src} width="38" height="38" alt="" />pg_warren<span class="brand-dot">.</span></a><Attribution /></div>
      <nav aria-label="Main navigation">
        <a href="#capabilities">Capabilities</a>
        <a href={`${base}/docs/examples/`}>Examples</a>
        <a class="docs-link" href={`${base}/docs/`}>Documentation</a>
        <a class="github-link" href={repo}>GitHub <span aria-hidden="true">↗</span></a>
        <button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme"><span aria-hidden="true">◐</span></button>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <a class="eyebrow release-note" href={`${base}/docs/changelog/`}><span class="status-dot"></span> PRE-1.0 · IN DEVELOPMENT <span aria-hidden="true">↗</span></a>
          <h1 id="hero-title">Fast graph analytics<br />inside PostgreSQL.</h1>
          <p class="hero-description">A graph engine inside Postgres. Find paths, rank what matters, spot communities, and test changes before you commit them. All in SQL, on the tables you already have.</p>
          <div class="hero-actions"><a class="button primary" href={`${base}/docs/installation/`}>Installation <span aria-hidden="true">↗</span></a><a class="button comparison-cta" href={`${base}/docs/positioning/`}>How is this different from pgGraph? <span aria-hidden="true">→</span></a></div>
          <p class="hero-performance">In our benchmarks over 12 real graphs, pg_warren was faster than pgGraph 1.2.1 on every workload both support (2.4–89× on shortest paths, 1.7–14× on connected components) and outperformed Neo4j + GDS on shortest-path and Louvain workloads, running entirely inside PostgreSQL. <a href={`${base}/docs/performance/`}>See results and methodology</a> for the warm medians, shared 4-vCPU setup, and workloads where other engines are faster.</p>
        </div>
        <div class="hero-art">
          <svg class="warren-map" viewBox="0 0 580 540" role="img" aria-labelledby="map-title map-desc">
            <title id="map-title">A warren of connections beneath your tables</title>
            <desc id="map-desc">A conceptual diagram: nodes and edges from ordinary PostgreSQL tables connect through a branching graph, with a highlighted traversal path.</desc>
            <defs>
              <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".14" /></pattern>
            </defs>
            <rect x="0" y="0" width="580" height="540" fill="url(#grid)" />
            <g class="contours" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M28 380C-40 200 135 69 287 94S573 188 556 346 344 561 206 480 82 520 28 380Z" />
              <path d="M51 368C-2 213 141 97 285 119S544 191 528 340 344 528 220 457 95 492 51 368Z" />
              <path d="M77 357C30 224 153 124 286 145S514 201 502 333 345 495 234 433 110 460 77 357Z" />
              <path d="M102 346C63 233 167 149 289 172S483 215 475 328 345 461 247 409 134 430 102 346Z" />
              <path d="M129 335C96 243 181 176 291 199S450 229 446 321 347 428 261 385 158 399 129 335Z" />
            </g>
            <g class="map-paths" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M105 286L198 207 299 265 404 189 493 257M105 286L173 381 299 265 354 407 463 365 493 257M198 207L237 121 349 107 404 189M173 381L130 439M354 407L319 479M463 365L532 418M299 265L463 365M198 207L173 381" />
            </g>
            <path class="active-path" d="M105 286L198 207 299 265 404 189" fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            <g class="small-nodes"><circle cx="237" cy="121" r="5"/><circle cx="349" cy="107" r="5"/><circle cx="493" cy="257" r="6"/><circle cx="173" cy="381" r="6"/><circle cx="354" cy="407" r="6"/><circle cx="463" cy="365" r="6"/><circle cx="130" cy="439" r="4"/><circle cx="319" cy="479" r="4"/><circle cx="532" cy="418" r="4"/></g>
            <g class="large-nodes" stroke-width="2"><circle cx="105" cy="286" r="15"/><circle cx="198" cy="207" r="12"/><circle cx="299" cy="265" r="12"/><circle cx="404" cy="189" r="12"/></g>
            <circle cx="105" cy="286" r="5" class="root-node" />
            <g class="map-labels"><text x="77" y="323">START</text><text x="182" y="182">01</text><text x="287" y="301">02</text><text x="394" y="163">03</text></g>
            <g class="table-tag"><rect x="300" y="25" width="240" height="48" rx="8"/><path d="M315 42h16m-16 6h16m-16 6h16m-11-12v12" fill="none" stroke="currentColor"/><text x="343" y="54">your ordinary tables</text></g>
            <path d="M418 73L404 129" class="table-connector" fill="none" stroke-dasharray="3 5" />
          </svg>
        </div>
      </section>
      <div class="foundation-strip"><div class="wrap"><span>POSTGRESQL 15–18</span><p>SQL-callable functions</p><span class="strip-plus" aria-hidden="true">·</span><p>Transactional graph versions</p><span class="strip-plus" aria-hidden="true">·</span><p>No separate graph service</p></div></div>

      <section class="example-section wrap section-space" aria-labelledby="example-title">
        <div class="section-heading"><span class="eyebrow">SQL EXAMPLE</span><h2 id="example-title">Traverse a graph.<br />Join the results.</h2><p>This breadth-first search returns nodes within three hops of Ada, including the start at depth zero. The result joins directly to the people table by external id.</p><a class="text-link" href={`${base}/docs/traversal/`}>Explore traversal <span aria-hidden="true">→</span></a></div>
        <div class="query-window">
          <div class="window-bar"><span><i></i><i></i><i></i></span><span>social.sql</span><button type="button" class="copy-query" aria-label="Copy traversal SQL">Copy SQL</button><span class="sr-only copy-status" role="status"></span></div>
          <div class="query-code"><Code code={query} lang="sql" theme="css-variables" /></div>
          <div class="query-result"><table aria-label="Nodes reached from Ada within three hops"><thead><tr><th scope="col">NAME</th><th scope="col">DEPTH</th></tr></thead><tbody>{[['ada',0],['bob',1],['cy',2],['dee',3]].map(([name, depth]) => <tr><td>{name}</td><td><span class="depth"><b aria-hidden="true" style={`--depth: ${depth}`}></b>{depth}</span></td></tr>)}</tbody></table></div>
          <div class="result-caption"><span class="status-dot"></span> Ada’s neighbourhood, up to three hops.</div>
        </div>
        <div class="example-note"><p>This query reads a built graph version. Refresh the graph to include later table changes.</p><details><summary>See the complete example setup</summary><Code code={setup} lang="sql" theme="css-variables" /><p>After installing the extension, run this setup in a fresh database, then run the query above. The example and its results are checked in the project’s <a href={`${repo}/blob/main/test/sql/docs_examples.sql`}>SQL documentation tests</a>.</p></details></div>
      </section>

      <section id="capabilities" class="possibilities section-space" aria-labelledby="possibilities-title"><div class="wrap">
        <div class="section-top"><div><span class="eyebrow">CAPABILITIES</span><h2 id="possibilities-title">Traversal, compute,<br />and change detection.</h2></div><p>One compact adjacency structure supports path queries, iterative graph algorithms, and structural comparisons between graph versions.</p></div>
        <div class="capabilities">
          <a href={`${base}/docs/traversal/`} class="capability"><span class="capability-number">01</span><svg viewBox="0 0 100 60" aria-hidden="true"><path d="M10 40L38 15 65 40 90 15"/><circle cx="10" cy="40" r="5"/><circle cx="38" cy="15" r="5"/><circle cx="65" cy="40" r="5"/><circle cx="90" cy="15" r="5"/></svg><h3>Deep traversal</h3><p>Breadth-first search, reachability, shortest paths, and typed walks with relation and node filters.</p><span class="capability-link">Traversal <span aria-hidden="true">↗</span></span></a>
          <a href={`${base}/docs/communities/`} class="capability"><span class="capability-number">02</span><svg viewBox="0 0 100 60" aria-hidden="true"><path d="M15 30L30 12 42 42 15 30M63 15L87 30 66 48 63 15M42 42L63 15"/><circle cx="15" cy="30" r="5"/><circle cx="30" cy="12" r="5"/><circle cx="42" cy="42" r="5"/><circle cx="63" cy="15" r="5"/><circle cx="87" cy="30" r="5"/><circle cx="66" cy="48" r="5"/></svg><h3>Graph algorithms</h3><p>PageRank, connected components, Louvain, Leiden, and spectral analysis over the same graph versions.</p><span class="capability-link">Algorithms & communities <span aria-hidden="true">↗</span></span></a>
          <a href={`${base}/docs/change-detection/`} class="capability"><span class="capability-number">03</span><svg viewBox="0 0 100 60" aria-hidden="true"><path d="M13 30L35 12 50 40 13 30M50 40L76 15 90 43 50 40"/><path class="new-edge" d="M35 12L76 15"/><circle cx="13" cy="30" r="5"/><circle cx="35" cy="12" r="5"/><circle cx="50" cy="40" r="5"/><circle cx="76" cy="15" r="5"/><circle cx="90" cy="43" r="5"/></svg><h3>Version comparisons</h3><p>Build a staged version, compare its structure, and decide whether to commit. In one transaction.</p><span class="capability-link">Versions & change detection <span aria-hidden="true">↗</span></span></a>
        </div>
      </div></section>

      <section class="architecture wrap section-space" aria-labelledby="architecture-title"><div class="section-top"><div><span class="eyebrow">ARCHITECTURE</span><h2 id="architecture-title">From tables to graph<br />to SQL results.</h2></div><p>Define your nodes and edges with two SQL queries. pg_warren builds a compact, memory-resident CSR adjacency structure. Your tables remain the source of truth.</p></div>
        <ol class="pipeline"><li><span class="pipeline-index">01</span><h3>Your tables</h3><p>Nodes and edges.<br />Defined with SQL.</p><code>create_graph</code></li><li><span class="pipeline-index">02</span><h3>A graph version</h3><p>Immutable. Transactional.<br />Built when you choose.</p><code>refresh</code></li><li><span class="pipeline-index">03</span><h3>Follow or compute</h3><p>Paths, vectors,<br />and whole-graph algorithms.</p><code>warren.*</code></li><li><span class="pipeline-index">04</span><h3>Back to your rows</h3><p>Join by node id.<br />Keep using SQL.</p><code>JOIN</code></li></ol>
        <div class="fit-note"><span class="eyebrow">WHEN TO USE IT</span><p>Small frontiers are a natural fit for recursive SQL. When a traversal touches a large part of the graph—or an algorithm repeatedly works over all of it—pg_warren gives that work a dedicated engine.</p><a class="text-link" href={`${repo}#when-to-use-it-frontier-size-not-hop-count`}>Find the right fit <span aria-hidden="true">↗</span></a></div>
      </section>

      <section id="get-started" class="get-started"><div class="wrap start-inner"><div><span class="eyebrow">INSTALLATION & DOCUMENTATION</span><h2>Use pg_warren</h2><p>Install the extension, define a graph, and run your first query.</p></div><div class="start-links"><a href={`${base}/docs/installation/`}><span><small>START HERE</small>Install pg_warren</span><span aria-hidden="true">↗</span></a><a href={`${base}/docs/traversal/`}><span><small>SQL FUNCTIONS</small>Read the traversal guide</span><span aria-hidden="true">→</span></a><a href={`${base}/docs/benchmarks/`}><span><small>PERFORMANCE</small>Read benchmark results</span><span aria-hidden="true">↗</span></a></div></div></section>
    </main>
    <footer class="wrap site-footer"><a class="brand" href={`${base}/`}><img src={mark.src} width="30" height="30" alt="" />pg_warren<span class="brand-dot">.</span></a><p>Graph traversal and computation for PostgreSQL.</p><nav aria-label="Footer"><a href={`${repo}/blob/main/LICENSE`}>Apache 2.0</a><a href={`${base}/docs/contributing/`}>Contribute ↗</a><a href={repo}>GitHub ↗</a></nav><p class="preview-note">Development documentation · See release notes for published software versions.</p></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      function updateThemeLabel() {
        const dark = document.documentElement.dataset.theme === 'dark';
        toggle?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
      }
      updateThemeLabel();
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('starlight-theme', theme); } catch { /* Theme still works without storage. */ }
        updateThemeLabel();
      });
      document.querySelector<HTMLButtonElement>('.copy-query')?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const code = document.querySelector('.query-code code')?.textContent;
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          button.textContent = 'Copied!';
          document.querySelector('.copy-status')!.textContent = 'Traversal SQL copied to clipboard.';
        } catch {
          button.textContent = 'Select SQL to copy';
          document.querySelector('.copy-status')!.textContent = 'Copy unavailable. Select and copy the SQL above.';
        }
        setTimeout(() => { button.textContent = 'Copy SQL'; }, 2500);
      });
    </script>
  </body>
</html>
